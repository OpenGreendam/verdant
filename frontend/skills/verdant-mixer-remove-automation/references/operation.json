            "properties": {
              "kind": {
                "enum": [
                  "master_gain",
                  "master_pan"
                ]
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "instance_id": {
                "type": "string"
              },
              "kind": {
