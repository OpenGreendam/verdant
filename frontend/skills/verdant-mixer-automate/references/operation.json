{
  "effect": "one_atomic_project_transaction",
  "native_units": true,
  "op": "mixer.automate",
  "params": {
    "additionalProperties": false,
    "properties": {
      "allowed_creator": {
        "type": "string"
      },
      "dry_run": {
        "type": "boolean"
      },
      "expect_project_id": {
        "type": "string"
      },
      "expect_revision": {
        "type": "integer"
      },
