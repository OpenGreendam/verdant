                    "type": "object"
                  },
                  "parameter_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "owner",
                  "instance_id",
                  "parameter_id"
                ],
                "type": "object"
              }
            ],
            "type": "object"
          }
        },
        "required": [
          "target",
          "points"
