              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "track_gain",
                      "track_pan"
                    ]
                  },
                  "track_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "track_id"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "master_gain",
                      "master_pan"
                    ]
                  }
                },
                "required": [
                  "kind"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "instance_id": {
                    "type": "string"
                  },
                  "kind": {
                    "const": "plugin_parameter"
                  },
                  "owner": {
